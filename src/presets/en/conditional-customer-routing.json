{
  "version": "1.0.0",
  "metadata": {
    "id": "f1a2b3c4-0001-4000-a000-000000000001",
    "name": "Conditional Customer Routing",
    "description": "Multi-branch customer support routing: classify issue type via LLM, route to Tech / Billing / General branches with dynamic branch skipping, and aggregate final response.",
    "author": "PatchCat Team",
    "tags": [
      "Condition",
      "Routing",
      "Aggregator",
      "Support"
    ],
    "createdAt": "2026-09-09T00:00:00Z",
    "updatedAt": "2026-09-09T00:00:00Z"
  },
  "viewport": {
    "x": 50,
    "y": 150,
    "zoom": 0.85
  },
  "nodes": [
    {
      "id": "input_ticket",
      "type": "input",
      "position": {
        "x": 50,
        "y": 250
      },
      "data": {
        "label": "Customer Ticket",
        "description": "Customer issue message and category indicator",
        "inputs": {
          "category": "technical",
          "query": "The database connection drops every 5 minutes with error 504 gateway timeout."
        }
      }
    },
    {
      "id": "cond_router",
      "type": "condition",
      "position": {
        "x": 350,
        "y": 250
      },
      "data": {
        "label": "Category Router",
        "description": "Evaluate ticket category to route to specialized prompt",
        "config": {
          "cases": [
            {
              "id": "case_tech",
              "label": "Technical",
              "conditions": [
                {
                  "variable": "input_ticket.category",
                  "operator": "equals",
                  "value": "technical"
                }
              ],
              "logicalOperator": "and"
            },
            {
              "id": "case_billing",
              "label": "Billing",
              "conditions": [
                {
                  "variable": "input_ticket.category",
                  "operator": "equals",
                  "value": "billing"
                }
              ],
              "logicalOperator": "and"
            }
          ],
          "defaultBranchLabel": "General"
        },
        "inputs": {
          "category": "{{input_ticket.category}}"
        }
      }
    },
    {
      "id": "prompt_tech",
      "type": "prompt",
      "position": {
        "x": 700,
        "y": 100
      },
      "data": {
        "label": "Tech Support Prompt",
        "description": "Engineering debugging prompt",
        "inputs": {
          "template": "You are a senior DevOps and backend support engineer. Provide actionable troubleshooting steps for: {{input_ticket.query}}"
        }
      }
    },
    {
      "id": "prompt_billing",
      "type": "prompt",
      "position": {
        "x": 700,
        "y": 250
      },
      "data": {
        "label": "Billing Support Prompt",
        "description": "Financial and invoicing prompt",
        "inputs": {
          "template": "You are an enterprise billing specialist. Guide the customer on payment and refund inquiries: {{input_ticket.query}}"
        }
      }
    },
    {
      "id": "prompt_general",
      "type": "prompt",
      "position": {
        "x": 700,
        "y": 400
      },
      "data": {
        "label": "General Support Prompt",
        "description": "General concierge assistant prompt",
        "inputs": {
          "template": "You are a customer satisfaction concierge. Politely answer this general query: {{input_ticket.query}}"
        }
      }
    },
    {
      "id": "aggregator_response",
      "type": "aggregator",
      "position": {
        "x": 1050,
        "y": 250
      },
      "data": {
        "label": "Branch Aggregator",
        "description": "Selects the prompt output from the executed branch",
        "config": {
          "mode": "first_available",
          "outputKey": "selected_prompt"
        },
        "inputs": {
          "tech": "{{prompt_tech.promptText}}",
          "billing": "{{prompt_billing.promptText}}",
          "general": "{{prompt_general.promptText}}"
        }
      }
    },
    {
      "id": "output_result",
      "type": "output",
      "position": {
        "x": 1350,
        "y": 250
      },
      "data": {
        "label": "Routed Output",
        "description": "Final assembled prompt ready for generation",
        "inputs": {
          "result": "{{aggregator_response.selected_prompt}}"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input_ticket",
      "target": "cond_router"
    },
    {
      "id": "e2",
      "source": "cond_router",
      "sourceHandle": "case_tech",
      "target": "prompt_tech"
    },
    {
      "id": "e3",
      "source": "cond_router",
      "sourceHandle": "case_billing",
      "target": "prompt_billing"
    },
    {
      "id": "e4",
      "source": "cond_router",
      "sourceHandle": "default",
      "target": "prompt_general"
    },
    {
      "id": "e5",
      "source": "prompt_tech",
      "target": "aggregator_response"
    },
    {
      "id": "e6",
      "source": "prompt_billing",
      "target": "aggregator_response"
    },
    {
      "id": "e7",
      "source": "prompt_general",
      "target": "aggregator_response"
    },
    {
      "id": "e8",
      "source": "aggregator_response",
      "target": "output_result"
    }
  ]
}