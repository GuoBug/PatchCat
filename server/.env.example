# PatchCat Server Configuration

# Application
APP_NAME="PatchCat Backend"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma separated or * for dev)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "*"]

# PostgreSQL + pgvector Database Connection
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://patchcat:patchcat_secret@localhost:5432/patchcat_db"
