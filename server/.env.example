# PatchCat Server Configuration

# Application
APP_NAME="PatchCat Backend"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port (Default to local loopback; non-loopback HOST requires API_AUTH_TOKEN in production)
HOST="127.0.0.1"
PORT=8000

# Access control: leave empty for local-only use. Required when HOST is not loopback.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=""
# Per-IP requests per minute (in-process). 0 disables.
RATE_LIMIT_PER_MINUTE=600

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# docker compose reads these (POSTGRES_PASSWORD is required, no default)
POSTGRES_USER=patchcat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=patchcat_db

# PostgreSQL + pgvector Database Connection
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://patchcat:change-me@localhost:5432/patchcat_db"
