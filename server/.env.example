# PatchCat Server Configuration

# Application
APP_NAME="PatchCat Backend"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port (Default to local loopback; use 0.0.0.0 only in container/production deployments)
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# PostgreSQL + pgvector Database Connection
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://patchcat:patchcat_secret@localhost:5432/patchcat_db"
